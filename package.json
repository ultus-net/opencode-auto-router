{
  "name": "opencode-auto-router",
  "version": "2.0.0",
  "description": "OpenCode plugin: Synthetic `syn:*` aliases as the primary provider, automatic failover to OpenRouter's Auto Router (openrouter/auto) with `~…-latest` support — no model version pinning.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "opencode",
    "opencode-plugin",
    "openrouter",
    "auto-router",
    "synthetic",
    "failover",
    "llm",
    "ai",
    "coding-agent"
  ],
  "license": "MIT",
  "author": "Hunter",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ultus-net/opencode-auto-router.git"
  },
  "bugs": {
    "url": "https://github.com/ultus-net/opencode-auto-router/issues"
  },
  "homepage": "https://github.com/ultus-net/opencode-auto-router#readme",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test \".tmp-tests/**/*.test.js\"",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "e2e:openrouter": "npm run build && node scripts/e2e-openrouter.mjs",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@opencode/plugin": ">=2.0.0"
  },
  "peerDependenciesMeta": {
    "@opencode/plugin": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opencode/plugin": "^2.0.21",
    "@types/node": "^22.10.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
